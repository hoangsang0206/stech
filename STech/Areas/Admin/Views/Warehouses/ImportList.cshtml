@model Tuple<WarehouseFilterVM, PagedList<WarehouseImport>>

@{
    ViewData["Title"] = "Danh sách phiếu nhập - STech Admin";
    ViewData["PageTitle"] = "Danh sách phiếu nhập";

    WarehouseFilterVM filter = Model.Item1;

    IEnumerable<Warehouse> warehouses = filter.Warehouses;
    IEnumerable<Supplier> suppliers = filter.Suppliers;

    PagedList<WarehouseImport> importList = Model.Item2;

    int i = 1;
}

<section class="page-wrapper">
    <div class="d-flex gap-2 align-items-center">
        <a class="page-btn btn-green" href="/admin/warehouses/import/create">
            <i class="fa-solid fa-plus"></i>
            <span>Tạo phiếu nhập</span>
        </a>
    </div>
    
    <div>
        <div class="d-flex align-items-center gap-2 mt-2 flex-wrap">
            <div>
                <div class="page-input" style="min-width: 15rem; max-width: 18rem">
                    <select class="filter-select-warehouse">
                        <option value="">Tìm theo kho</option>
                        @foreach (Warehouse warehouse in warehouses)
                        {
                            if (filter.WarehouseId == warehouse.WarehouseId)
                            {
                                <option selected value="@warehouse.WarehouseId">@warehouse.WarehouseName</option>
                            }
                            else
                            {
                                <option value="@warehouse.WarehouseId">@warehouse.WarehouseName</option>
                            }
                        }
                    </select>
                </div>
            </div>
        
            <div>
                <div class="page-input"  style="min-width: 15rem; max-width: 18rem">
                    <select class="filter-select-supplier">
                        <option value="">Tìm theo NCC</option>
                        @foreach (Supplier supplier in suppliers)
                        {
                            if (filter.SupplierId == supplier.SupplierId)
                            {
                                <option selected value="@supplier.SupplierId">@supplier.SupplierName</option>
                            }
                            else
                            {
                                <option value="@supplier.SupplierId">@supplier.SupplierName</option>
                            }
                        }
                    </select>
                </div>
            </div>
        
            <div>
                <div class="page-input text-nowrap date-range-picker" data-filter-date="@filter.DateRange">
                    <i class="fa fa-calendar"></i>&nbsp;
                    <span></span> <i class="fa fa-caret-down"></i>
                </div>
            </div>
        
            <div>
                <div class="page-input">
                    <input value="@filter.ProductId" class="filter-prod-id" placeholder=" Tìm theo mã SP"/>
                </div>
            </div>
        
            <div>
                <div class="page-input">
                    <input value="@filter.EmployeeId" class="filter-staff-id" placeholder="Tìm theo mã NV"/>
                </div>
            </div>
        
            <div>
                <div class="page-input">
                    <input value="@filter.ItemId" class="filter-import-id" placeholder="Tìm theo mã phiếu"/>
                </div>
            </div>
        
            <button class="page-btn filter-submit">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>
        </div>
        <div class="d-flex gap-2 mt-2">
            <div class="page-dropdown sort-selection">
                <div class="page-dropdown-btn">
                    <span>Sắp xếp theo</span>
                    <i class="fa-solid fa-caret-down"></i>
                </div>
                <div class="page-dropdown-content">
                    <div class="page-dropdown-item" data-value data-text="Sắp xếp theo">Sắp xếp theo</div>
                    <div class="page-dropdown-item" data-value="date-create-asc" data-text="Ngày tạo &#8593;">Ngày tạo &#8593;</div>
                    <div class="page-dropdown-item" data-value="date-create-desc" data-text="Ngày tạo &#8595;">Ngày tạo &#8595;</div>
                    <div class="page-dropdown-item" data-value="date-import-asc" data-text="Ngày nhập &#8593;">Ngày nhập &#8593;</div>
                    <div class="page-dropdown-item" data-value="date-import-dest" data-text="Ngày nhập &#8595;">Ngày nhập &#8595;</div>
                    <div class="page-dropdown-item" data-value="total-price-asc" data-text="Tổng giá trị &#8593;">Tổng giá trị &#8593;</div>
                    <div class="page-dropdown-item" data-value="total-price-desc" data-text="Tổng giá trị &#8595;">Tổng giá trị &#8595;</div>
                    <div class="page-dropdown-item" data-value="total-qty-asc" data-text="Tổng sản phẩm &#8593;">Tổng sản phẩm &#8593;</div>
                    <div class="page-dropdown-item" data-value="total-qty-desc" data-text="Tổng sản phẩm &#8595;">Tổng sản phẩm &#8595;</div>
                </div>
            </div>
            
            <div class="page-dropdown status-selection">
                <div class="page-dropdown-btn">
                    <span>Trạng thái</span>
                    <i class="fa-solid fa-caret-down"></i>
                </div>
                <div class="page-dropdown-content">
                    <div class="page-dropdown-item" data-value data-text="Trạng thái">Trạng thái</div>
                    <div class="page-dropdown-item" data-value="@StatusConstant.Waiting" data-text="Chờ xác nhận">Chờ xác nhận</div>
                    <div class="page-dropdown-item" data-value="@StatusConstant.Completed" data-text="Đã hoàn thành">Đã hoàn thành</div>
                    <div class="page-dropdown-item" data-value="@StatusConstant.Canceled" data-text="Đã hủy">Đã hủy</div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="mt-3">
        <div class="page-table-wrapper">
            <table class="page-table">
                <thead class="page-table-header">
                <tr>
                    <th>STT</th>
                    <th>Mã phiếu</th>
                    <th>Ngày tạo</th>
                    <th>Ngày nhập</th>
                    <th>Tổng SP</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
                </thead>
                
                <tbody class="import-list">
                    @foreach (WarehouseImport import in importList.Items)
                    {
                        string statusHtml = "<span class=\"page-badge badge-warning\">Chờ xác nhận</span>";

                        if (import.Status == StatusConstant.Completed)
                        {
                            statusHtml = "<span class=\"page-badge badge-success\">Hoàn thành</span>";
                        }
                        else if (import.Status == StatusConstant.Canceled)
                        {
                            statusHtml = "<span class=\"page-badge badge-error\">Đã hủy</span>";
                        }
                        
                        <tr>
                            <td>@(i)</td>
                            <td>@(import.Wiid)</td>
                            <td>@(import.DateCreate.ToString("dd/MM/yyyy hh:mm tt"))</td>
                            <td>@(import.DateImport.HasValue ? import.DateImport?.ToString("dd/MM/yyyy hh:mm tt") : "--")</td>       
                            <td>@(import.WarehouseImportDetails.Sum(t => t.Quantity))</td>
                            <td>@(CurrencyFormatter
                                    .Format(import.WarehouseImportDetails.Sum(t => t.UnitPrice * t.Quantity)))</td>
                            <td>@Html.Raw(statusHtml)</td>
                            <td>
                                <button class="page-table-btn btn-lightblue">
                                    <i class="fa-solid fa-circle-info"></i>
                                </button>
                            </td>

                        </tr>
                        
                        i++;
                    }
                </tbody>
            </table>
        </div>
    </div>
    
</section>

@section Scripts
{
    <script src="~/admin/js/warehouse/warehouseimport.js"></script>
}
